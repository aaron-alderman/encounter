[Unit]
Description=Sourcery Google Workspace identity bridge
After=network-online.target sourcery-hosted.service
Wants=network-online.target

[Service]
Type=simple
User=sourcery-identity
Group=sourcery-identity
EnvironmentFile=/etc/sourcery-google/google.env
ExecStartPre=/usr/local/libexec/sourcery-google-identity google-identity-custody
ExecStart=/usr/local/libexec/sourcery-google-identity google-identity
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
RemoveIPC=true
KeyringMode=private
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
