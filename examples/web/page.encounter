process-module "temple/surface-process-module/1"

process app.newSession:
  let result = {}

process app.request:
  let result = {
    html = "<!doctype html><html lang='en'><meta charset='utf-8'><title>Encounter demo</title><link rel='stylesheet' href='/styles.css'><main><h1>Hello from Encounter</h1><p>This page is served by an Encounter process.</p></main></html>";
    session = $eventInput.session
  }

process ui.styles:
  let result = "body { font: 1rem system-ui; margin: 3rem; } main { max-width: 42rem; }"
