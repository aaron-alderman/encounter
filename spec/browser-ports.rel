("browser", "version", "encounter/browser-ports/1")
("browser", "transport", "Same-origin loopback WebSocket, one Encounter session per connection")
("browser", "boot", "browser.boot")
("operator.window", "semantics", "Opt-in Temple window host with origin-bound form login and a secure, host-only, partitioned browser session. The private host stores only token hashes and credential bindings. Logout revokes the lease, and browser dispatch rejects expired or revoked leases.")
("operator.window", "mount", "An optional name after the port in --temple-window binds mount for the admitted browser programme. The name is a launch parameter independent of the browser URL and store profile.")
("browser", "event", "Declared entry registered by the root through browser.on")
("browser", "dataBoundary", "The browser supplies observations, including local storage and DOM events")
("runtime.telemetry", "input", "{}")
("runtime.telemetry", "output", "{elapsedMs,cpuMicros,peakResidentBytes,activeSessions,sessionLimit,completedDispatches,faultedDispatches}")
("runtime.telemetry", "semantics", "Explicit application grant. Samples only the current Encounter host process and its browser sessions. CPU time and peak resident bytes come from process resource usage. Counts cover browser dispatches since host start, including monitor ticks and excluding boot.")
("runtime.environment", "input", "{}")
("runtime.environment", "output", "{memory:Capacity|Null,disk:Capacity|Null}, Capacity={totalBytes,availableBytes}")
("runtime.environment", "semantics", "Explicit read-only grant. Reports Linux host RAM and the filesystem of the configured release or assets. The caller supplies no path. Missing observations return null independently.")
("browser.copyText", "input", "{trigger:ID,source:ID,status:ID}")
("browser.copyText", "semantics", "Bind a trusted local click to copy the named read-only textarea. Clipboard refusal reveals and selects the field for manual copy. No clipboard read, host exchange or clipboard data returned.")
("browser.performance", "input", "{id?:Text}")
("browser.performance", "output", "Launch summary sequence, or a single launch with detail by ID")
("browser.performance", "semantics", "Reads the latest 30 opt-in click timings in the current document. Detail reports input delay, earlier dispatch overlap, host and browser exchange times, and up to 48 browser steps. Only programme labels, operation names, durations and outcomes are retained. A missing launch ID returns null.")
("runtime.clock", "input", "{}")
("runtime.clock", "output", "Integer")
("runtime.clock", "semantics", "Explicit application grant. UTC milliseconds from the Encounter host clock.")
("runtime.nonce", "input", "{}")
("runtime.nonce", "output", "48 lowercase hexadecimal digits from native random bytes")
("runtime.device", "input", "{}")
("runtime.device", "semantics", "Read-only compiled host platform and Encounter version. A configured device host reads projected per-app counters from the private edge status socket. Missing or invalid samples return a null edge and never expose the socket path or credentials.")
("device.check", "route", "GET /_encounter/device/check/{registered-app-slug}")
("device.check", "semantics", "Opt-in declared entry on a durable host. The loopback gateway supplies the app slug, the runtime supplies UTC milliseconds, and only a true result grants admission. Reachable ports are restricted to read-only store, relation and number operations.")
("device.edge", "semantics", "Native loopback transport driven by a generated encounter/device-edge/1 routing plan. It checks the declared admission entry on each new flow and periodically revokes active flows by shutting down both sockets. The gateway reaches each route through a private Unix socket.")
("device.window", "semantics", "Linux app-mode launcher for a declared loopback gateway. It keeps a dedicated private renderer profile and applies an inherited Landlock TCP port allowlist before executing Chromium with its own sandbox enabled.")
("state.get", "input", "{key:Text,scope?:Text}")
("state.get", "output", "Value|Null")
("state.set", "input", "{key:Text,value:Value,scope?:Text}")
("state.set", "output", "Boolean")
("state.set", "lifetime", "Browser connection by default; document when scope is document")
("storage.read", "input", "{key:Text,maxLength?:Integer,scope?:Text}")
("storage.read", "output", "{ok:Boolean,value:Text|Null}")
("storage.read", "semantics", "Missing key yields null. The length limit is in UTF-16 code units and defaults to 65536.")
("storage.write", "input", "{key:Text,value:Text,scope?:Text}")
("storage.write", "output", "{ok:Boolean}")
("storage.write", "lifetime", "Browser local storage for the serving origin by default. Both read and write use session storage when scope is tab.")
("storage.readRecord", "input", "{key:Text,maxLength?:Integer}")
("storage.readRecord", "output", "{ok:Boolean,value:Text|Null}")
("storage.readRecord", "semantics", "Reads a transactional origin-local text record. A missing key yields null. The default length limit is 65536 UTF-16 code units.")
("storage.compareAndSet", "input", "{key:Text,expected:Text|Null,value:Text}")
("storage.compareAndSet", "output", "{ok:Boolean}")
("storage.compareAndSet", "semantics", "Compares and replaces one origin-local text record in a transaction. Null expects an absent record. A conflict or failed write yields false.")
("storage.remove", "input", "{key:Text}")
("storage.remove", "output", "{ok:Boolean}")
("dom.exists", "input", "{selector:Text}")
("dom.exists", "output", "Boolean")
("browser.on", "input", "{ref:DomRef,event:Text,query:ProcessName,input?:Record,delegate?:Text,outside?:Text,unmodified?:Boolean,preventDefault?:Boolean,preventKeys?:Sequence<Text>,milliseconds?:Integer,timing?:Text,reveal?:Text,dispatchLabel?:Text,backgroundSession?:Boolean,initialSession?:Boolean}")
("browser.on", "output", "BindingId")
("browser.on", "interval", "A window or document interval runs while the bridge is idle. A selector interval also requires at least one rendered match before dispatch.")
("browser.on", "workspace-access", "During native boot, a window workspace-access binding with browser.request reads the same-origin /workspace/access route in the background. The event carries a Boolean platform field for link visibility. It grants no access.")
("browser.on", "semantics", "Serial dispatch supplies event and matched observations to the registered entry. A backgroundSession focus or pageshow binding on window coalesces overlapping reads of the same-origin workspace session outside serial dispatch and delivers a session summary or null. initialSession starts that observation when the listener registers during boot. This observation grants no access.")
("browser.appDescriptions", "input", "{ref:DomRef}")
("browser.appDescriptions", "output", "Boolean")
("browser.appDescriptions", "semantics", "Observes clamped summaries inside up to 128 shared app cards. Overflow enables an ellipsis button with a full-description popover for hover and activation.")
("browser.countdown", "input", "{ref:ID,control:ID,surface:ID,container:DomRef,choices:Sequence<{value:Text,milliseconds:Integer,default?:Boolean}>,storageKey:Text,query:ProcessName,dispatchLabel?:Text}")
("browser.countdown", "semantics", "A local countdown observes its select and hidden surfaces, persists the selected option in browser storage, and dispatches its declared query only when due and the browser bridge is idle. Zero milliseconds means paused.")
("browser.activeGroup", "input", "{ref:DomRef,members:Sequence<ID>}")
("browser.activeGroup", "semantics", "Registers 1 to 64 distinct direct children as an exclusive active group. Pointerdown and focusin activate their member synchronously in the browser. Repeating the active member performs no DOM write or host dispatch.")
("browser.activate", "input", "{group:DomRef,member:ID}")
("browser.activate", "semantics", "Activates a registered member, changing data-active only on the previous and next members. Available in an ordered browser batch.")
("browser.batch", "input", "{steps:Sequence<{port:Text,args:Record,save?:Text,unless?:Text}>,diagnosticLabel?:Text}|{preflight:Sequence<{port:Text,args:Record}>,probes?:Record<Text,Text>,when?:Text,stableIds?:Sequence<Text>,deferContent?:Boolean}")
("browser.batch", "output", "Record of named observations or Boolean")
("browser.batch", "semantics", "Runs 1 to 64 ordered DOM existence, property, write, attribute, focus or activate effects in one browser exchange. An unless guard refers to a preceding unguarded named dom.exists observation and skips the step when true. A failed effect stops the batch. During native boot, preflight can return named DOM probes and snapshot 1 to 64 declared local reads if the optional selector matches. Plain URL startup may be inspected without consuming it. stableIds identifies shell elements outside replaced content. deferContent allows declared content writes to share a boot exchange with other setup effects. Setup effects are acknowledged before the browser becomes ready.")
("browser.onMany", "input", "{bindings:Sequence<BrowserBinding>}")
("browser.onMany", "output", "Sequence<BindingId>")
("browser.onMany", "semantics", "Register 1 to 32 browser.on bindings in order in one browser round trip. A failed batch registers no listeners.")
("browser.property", "input", "{ref:DomRef,name:Text}")
("browser.property", "output", "Text|Number|Boolean|Null")
("browser.formFields", "input", "{ref:DomRef}")
("browser.formFields", "semantics", "Observes the text fields of a form using browser form control rules. Rejects file entries, duplicate names, more than 64 fields, or more than 16384 UTF-16 code units.")
("browser.write", "input", "{ref:DomRef,name:Text,value:Value}")
("browser.write", "output", "Boolean")
("browser.content", "input", "{ref:DomRef,html:Text}")
("browser.content", "output", "Boolean")
("browser.focus", "input", "{ref:DomRef,preventScroll?:Boolean}")
("browser.focus", "output", "Boolean")
("browser.dialog", "input", "{ref:DomRef,open:Boolean,close?:Text,content?:{ref:DomRef,html:Text},position?:{x:Number,y:Number}|{anchor:DomRef}}")
("browser.dialog", "output", "Boolean")
("browser.dialog", "semantics", "Optionally update a descendant and close the dialog matching the supplied selector before opening the target. A selector with no match is a no-op. A document-level modal can be positioned at a viewport point or at a trigger and is kept within the viewport on opening.")
("browser.attribute", "input", "{ref:DomRef,name:Text,value:Value}")
("browser.attribute", "semantics", "Boolean aria-pressed and data attributes, and bounded PNG data URLs on image elements")
("browser.attribute", "output", "Boolean")
("browser.guard", "input", "{active:Selector,allow:Selector,within:Selector}")
("browser.guard", "semantics", "While the active selector exists, prevent clicks, auxiliary clicks, and context menus on controls matching within. A click inside allow proceeds.")
("browser.guard", "output", "Boolean")
("browser.location", "input", "{}")
("browser.location", "output", "{path:Text,search:Text,hash:Text}")
("browser.startup", "input", "{receiver:Text,paths:List(Text),hashes?:List(Text),encoded?:List(Text)}")
("browser.startup", "output", "{first:Boolean,path:Text,hadInput:Boolean,hash:Text,fields:Record}")
("browser.startup", "semantics", "Claim the initial document URL once per receiver. On an admitted path, remove its query and any admitted launch fragment without adding a history entry. Duplicate query fields invalidate the input.")
("browser.navigate", "input", "{path:Text,historyOnly?:Boolean}")
("browser.navigate", "output", "Boolean")
("browser.target", "input", "{ref:DomRef}")
("browser.target", "output", "{path:Text,pathname:Text,method:Text}")
("browser.request", "input", "{path:Text,method?:Text,bearer?:Text,form?:DomRef,fragment?:Selector,query?:Record,rows?:{row:Selector,fields:Record<Text,{selector?:Selector,attr?:Text}>}}")
("browser.request", "projection", "A successful GET can project up to 100 rows and 8 text fields from its bounded response markup without mounting it.")
("browser.request", "output", "{status:Integer,body:Text|Null,rows?:Sequence<Record<Text,Text>>}")
("browser.request", "semantics", "Bounded same-origin GET or POST, with manual redirects and optional URL-encoded form and HTML fragment")
("browser.frontGateStatus", "input", "{countdown?:ID}")
("browser.frontGateStatus", "output", "{status:Integer,body:Text|Null}")
("browser.frontGateStatus", "semantics", "Explicit AppDev browser grant. Reads only the Front Gate status route on localhost at the published SSH port. Sends no credentials and refuses redirects. An optional countdown marks the request in the matching local timer.")
("browser.requestOnExit", "input", "{path:Text|Null,bearer?:Text}")
("browser.requestOnExit", "semantics", "Send one same-origin keepalive POST on page exit. A null path clears the pending request.")
("browser.requestOnExit", "output", "Boolean")
("browser.delay", "input", "{milliseconds:Integer}")
("browser.delay", "output", "Boolean")
("browser.fileText", "input", "{ref:DomRef,maxBytes:Integer}")
("browser.fileText", "output", "Text")
("download.text", "input", "{name:Text,text:Text}")
("download.text", "output", "Boolean")
("kernel.prepare", "input", "{text:Text,entry:ProcessName}")
("kernel.prepare", "output", "{admission:SessionTicket,sourceHash:Sha256,entry:ProcessName}")
("kernel.prepare", "semantics", "Admit the pure reachable source under the caller's meter. Each ticket binds immutable code and entry to this connection.")
("kernel.execute", "input", "{admission:SessionTicket,input?:Value}")
("kernel.execute", "output", "Value")
("kernel.execute", "semantics", "Execute the admitted child under the caller's meter with fresh locals and no browser or application grants.")
("browser.durable", "launch", "browser-host --durable APP_ROOT DECLARATION ASSETS STORE OPERATORS PORT")
("browser.durable", "semantics", "Verified operator and private store context are host bindings. Reconnect runs application boot and discards connection-local events.")
("browser.form", "launch", "browser-host --form-store APP_ROOT DECLARATION ASSETS STORE PORT")
("form.sessionOpen", "input", "{token:Text|Null,initial:Record}")
("form.sessionOpen", "output", "Text")
("form.sessionOpen", "semantics", "Bind one private form session to this connection. Return its opaque resume token. Sessions are bound to the application basis.")
("form.sessionBegin", "input", "{}")
("form.sessionBegin", "output", "Record")
("form.sessionBegin", "semantics", "Read the bound session under a write transaction. Unfinished transactions roll back when dispatch ends.")
("form.sessionSave", "input", "{state:Record}")
("form.sessionSave", "output", "Boolean")
("form.sessionSave", "semantics", "Commit up to 32 KiB of session state and renew the session for eight hours.")
("browser.temple", "launch", "browser-host --temple APP_ROOT DECLARATION ASSETS STORE OPERATORS PEERS PORT")
("browser.temple", "semantics", "One authenticated local operator and one pinned loopback Temple peer. Configuration and key files remain outside assets, and store identity is scoped to the configured public pins.")
("browser.temple", "receive", "One WebSocket envelope invokes declared peer.receive with host profile and basis. Encounter verifies before committing or signing a receipt. Refusal yields null.")
("peer.context", "input", "{}")
("peer.context", "output", "{local:{templeId,actor,publicKey},remote:{templeId,actor,publicKey}}")
("peer.attest", "input", "{slot:Text,statement:Record}")
("peer.attest", "output", "Temple3 signed attestation")
("peer.attest", "semantics", "Sign a bounded canonical ASCII statement under the configured Temple and actor. The host retains the signing key.")
("peer.exchange", "input", "{envelope:Record}")
("peer.exchange", "output", "Peer receipt or Null")
("peer.exchange", "semantics", "Send one bounded WebSocket message to the configured peer. Outbound browser dispatch only. Encounter verifies the correlated reply.")

("browser.popover", "input", "{ref:DomRef,open:Boolean,position?:{x:Number,y:Number}|{anchor:DomRef}}")
("browser.popover", "output", "Boolean")
("browser.popover", "semantics", "Open a document-level auto popover at a viewport point or trigger. Opening requires a position. The browser handles light dismissal and keeps the background interactive.")

("browser.asterStream", "input", "{query:DeclaredBrowserEntry,input?:Record}")
("browser.asterStream", "output", "Integer")
("browser.asterStream", "semantics", "Registers one Ask Aster subscription on an explicitly approved native browser host. The platform uses only the same-origin Aster event endpoint and a thread watch issued by the Aster chat service.")
