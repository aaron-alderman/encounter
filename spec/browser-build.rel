("build", "contract", "encounter/browser-build/1")
("build", "origin", "Retained provenance record with vendor input pins")
("build", "frontend", "Primary pinned process frontend declaration")
("build", "bootstrap", "Static bootstrap owner for fragment, definition and library declarations")
("build", "projection", "Alternative authored entry returning named static projections")
("build", "ownerModule", "Source module linked into the static projection")
("build", "document", "Process rendering the publication document")
("build", "styles", "Process rendering the publication stylesheet")
("build", "dataModule", "Authored process module assembling initial runtime data")
("build", "dataEntry", "Data assembly entry in the declared module")
("build", "preparation", "Root entry whose admitted result prepares a child")
("build", "childBinding", "Explicit binding forwarded to an admitted child")
("data", "input", "One fact per input name and JSON source or authored projection path")
("text", "input", "One fact per input name and exact-text source path")
("library", "input", "One fact per logical source path and path under the supplied library root")
("receipt", "contract", "encounter/browser-build-receipt/1")
("receipt", "source", "One fact per logical input or derived projection and its SHA-256")
("receipt", "artifact", "One fact per output path and its SHA-256")
("release", "launch", "encounter browser-host --release DIRECTORY RECEIPT_SHA256 PORT")
("release", "verification", "Verify independently supplied receipt pin, executable hash and every declared artifact before listening")
("release", "delivery", "Serve only verified assets using the bytes captured at startup")
("build", "runtimeProtocol", "Expected protocol of the authored runtime projection")
("build", "runtimeLowering", "The authored runtime lowerer and definitions must match the pinned primary frontend")
("wasm", "contract", "encounter/browser-wasm/1")
("wasm", "source", "Encounter process module relative to the build root")
("wasm", "entry", "Each export names an Encounter process. A module supports 1 to 128 public entries.")
("wasm", "helper", "Names a typed scalar Encounter process callable inside the module. It uses parameter and result declarations and is excluded from the browser exports and export map. A module supports up to 64 private helpers in addition to its public entries.")
("wasm", "parameter", "Ordered name:Type parameters, where Type is Number, Boolean, or Text")
("wasm", "text", "Text uses a packed byte length and offset. The browser writes observations into the first 64 KiB page. Compiled literals of up to 128 UTF-16 code units share a separate fixed page. Text spans stay within one page. Results return up to 128 code units from either page. Two inputs compare up to 128 code units by default.")
("wasm", "text-equality-limit", "Optional wasm.textEqualityUnits raises the input-to-input equality limit to at most 4096 code units and exports that bound as an immutable global. Literal and prefix or suffix matching retain their existing bounds.")
("wasm", "result", "One Number, Boolean, or Text, or 2 to 8 named scalar fields from a final record literal. Multiple values are returned in REL declaration order and listed in the source map.")
("wasm", "call", "A declared straight-line scalar helper reads named caller locals and sets result. Helpers use let, number.calculate, and calls to other declared scalar helpers. Calls must be acyclic. An entry allows at most 96 nested calls and 16384 expanded statements, counting conditional bodies. Helpers have no branch statements. The helper declares its parameter and result types.")
("wasm", "when", "A Boolean branch can update initialized locals without changing their types. New branch locals are scoped to the branch.")
("wasm", "literal-lookup", "at(list(...), index) supports 1 to 32 homogeneous Number, Boolean, or Text literals. Guard the index if it can be fractional or outside the list. A missing value traps at the scalar ABI.")
("wasm", "artifacts", "browser.wasm, browser.wasm.map.rel, and build-receipt.rel")
("live-client", "launch", "In encounter/launch/1, the optional live-events and canvas subjects each declare directory and receiptSha256. The host verifies the bundle and serves its Wasm bytes under the existing client script URL.")
("live-client", "canvas-pins", "A live application with app.canvas supplies both client pins when using pinned browser Wasm.")
("preview-client", "launch", "In encounter/gateway/1, the optional preview-client subject declares directory and receiptSha256. The gateway verifies the bundle and serves its Wasm bytes for the declared preview script route.")
("appdev-wasm", "contract", "encounter/appdev-browser-wasm-build/3")
("appdev-wasm", "module", "Build the Aster frame, assurance, countdown, interaction, mobile, and temple modules together")
("appdev-wasm", "artifacts", "browser-wasm.rel and the individually receipted directories under browser-wasm/")
("appdev-work-wasm", "contract", "encounter/appdev-work-browser-wasm-build/1")
("appdev-work-wasm", "module", "Build the shared interaction module for a packaged Work browser host")
("wasm", "math", "Optional declaration of sin, cos, hypot, or remainder. These are pure f64 functions supplied by the encounter.math browser port.")
("wasm", "text-match", "text.startsWith and text.endsWith accept a bounded Text observation and a search literal.")
