process-module "temple/surface-process-module/1"

process credentialIssuance.invalidExpiry:
  port kernel.invoke { query = "controlAccess.refuse"; input = { status = 400; code = "credential-expiry-invalid";
    message = "Personal credential expiry must be between one minute and ten years from now." } } → result

process credentialIssuance.request:
  let input = $eventInput
  let personal = eq($input.operation, "personal")
  assert includes(list("personal", "tenant"), $input.operation)
    otherwise "Unsupported hosted credential issuance operation."
  when or(eq($input.mode, "disabled"), and(not($personal), not(eq($input.mode, "enabled")))):
    port kernel.invoke { query = "controlAccess.refuse"; input = { status = 403; code = "developer-credentials-disabled";
      message = "Developer credentials are disabled by this deployment." } } → denied
  port value.type { value = at($input.principal, "userId") } → user
  when and($personal, not(and(eq(at($input.principal, "kind"), "user"), eq($user, "string")))):
    port kernel.invoke { query = "controlAccess.refuse"; input = { status = 403; code = "user-required";
      message = "This operation requires an authenticated hosted user." } } → denied
  port kernel.invoke { query = "controlAccess.boundedText"; input = { value = $input.name; name = "credential name"; limit = 160 } } → name
  when not(and(isArray($input.permissions), count($input.permissions))):
    port kernel.invoke { query = "controlAccess.refuse"; input = { status = 400; code = "credential-permissions-invalid";
      message = "A developer credential needs at least one permission." } } → denied
  let supported = list("project.read", "workspace.read", "workspace.write", "secret.read", "secret.write",
    "authoring.read", "authoring.write", "projects.observe", "projects.request", "projects.decide", "projects.provision")
  fold $input.permissions as permission; permissions starts list():
    port value.string { value = $permission } → name
    when not(includes($supported, $name)):
      port kernel.invoke { query = "controlAccess.refuse"; input = { status = 400; code = "credential-permissions-invalid";
        message = "A developer credential contains an unsupported permission." } } → denied
    yield append($permissions, list($name)) → permissions
  port value.sort { values = distinct($permissions) } → permissions
  let expires = null
  when $personal:
    when and($input.explicitExpiry, not(eq($input.expiresInMs, null))):
      port kernel.invoke { query = "controlAccess.refuse"; input = { status = 400; code = "credential-expiry-invalid";
        message = "Choose either an exact credential expiry or a relative lifetime, not both." } } → denied
    let duration = if(eq($input.expiresInMs, null), 31622400000, $input.expiresInMs)
    let expires = $input.expiresAtMs
    when not($input.explicitExpiry):
      port number.isNatural { value = $duration } → integer
      when not($integer):
        port kernel.invoke { query = "credentialIssuance.invalidExpiry"; input = null } → denied
      port number.calculate { operation = "add"; values = list($input.nowMs, $duration) } → expires
    port number.isNatural { value = $expires } → valid
    port number.calculate { operation = "add"; values = list($input.nowMs, 60000) } → minimum
    port number.calculate { operation = "add"; values = list($input.nowMs, 316224000000) } → maximum
    port number.calculate { operation = "greaterEqual"; values = list($expires, $minimum) } → above
    port number.calculate { operation = "lessEqual"; values = list($expires, $maximum) } → below
    when not(and($valid, $above, $below)):
      port kernel.invoke { query = "credentialIssuance.invalidExpiry"; input = null } → denied
  when not($personal):
    let duration = $input.expiresInMs
    port number.isNatural { value = $duration } → integer
    port number.calculate { operation = "greaterEqual"; values = list($duration, 60000) } → above
    port number.calculate { operation = "lessEqual"; values = list($duration, 31622400000) } → below
    when not(and($integer, $above, $below)):
      port kernel.invoke { query = "controlAccess.refuse"; input = { status = 400; code = "credential-ttl-invalid";
        message = "Developer credential TTL must be between one minute and 366 days." } } → denied
    port number.calculate { operation = "add"; values = list($input.nowMs, $duration) } → expires
  port time.formatUtc { milliseconds = $expires; fractional = true } → expiresAt
  let result = { personal = $personal; name = $name; permissions = $permissions; expiresAt = $expiresAt;
    tenantId = $input.tenantId; appId = $input.appId; projectId = $input.projectId; workspaceId = $input.workspaceId }

process credentialIssuance.notFound:
  port kernel.invoke { query = "controlAccess.refuse"; input = { status = 404; code = "not-found";
    message = concat($eventInput, " was not found.") } } → result

process credentialIssuance.record:
  let input = $eventInput
  let snapshot = $input.snapshot
  let scope = $input.scope
  let principal = $input.principal
  let tenant = $snapshot.tenant
  let app = $snapshot.app
  let project = $snapshot.project
  let workspace = $snapshot.workspace
  when not(and($tenant, eq($tenant.id, $scope.tenantId))):
    port kernel.invoke { query = "credentialIssuance.notFound"; input = "Tenant" } → denied
  when not(and($app, eq($app.id, $scope.appId), eq($app.tenantId, $tenant.id))):
    port kernel.invoke { query = "credentialIssuance.notFound"; input = "App" } → denied
  let portfolio = and($scope.personal, eq($scope.projectId, null))
  when not($portfolio):
    when not(and($project, eq($project.id, $scope.projectId), eq($project.tenantId, $tenant.id), eq($project.appId, $app.id))):
      port kernel.invoke { query = "credentialIssuance.notFound"; input = "Project" } → denied
  when $scope.workspaceId:
    when not(and($workspace, $project, eq($workspace.id, $scope.workspaceId), eq($workspace.tenantId, $tenant.id),
      eq($workspace.appId, $app.id), eq($workspace.projectId, $project.id))):
      port kernel.invoke { query = "credentialIssuance.notFound"; input = "Workspace" } → denied
    when $portfolio:
      port kernel.invoke { query = "controlAccess.refuse"; input = { status = 400; code = "credential-scope-invalid";
        message = "An application-portfolio credential cannot select a workspace." } } → denied
  let member = $snapshot.member
  when not($scope.personal):
    port kernel.invoke { query = "controlAccess.authorize"; input = { principal = $principal; tenantId = $tenant.id;
      membership = $member; permission = "credential.manage";
      scope = { projectId = $scope.projectId; workspaceId = $scope.workspaceId } } } → admitted
  when $scope.personal:
    when not(and($member, eq($member.userId, $principal.userId), eq($member.tenantId, $tenant.id),
      includes(list("owner", "admin", "developer", "viewer"), $member.role), not($member.revokedAt))):
      port kernel.invoke { query = "controlAccess.refuse"; input = { status = 403; code = "forbidden";
        message = "The resource is outside this identity's tenant scope." } } → denied
    let role = null
    when not($portfolio):
      let projectMember = $snapshot.projectMember
      let explicit = if(and($projectMember, eq($projectMember.userId, $principal.userId),
        eq($projectMember.projectId, $project.id), eq($projectMember.tenantId, $tenant.id),
        eq($projectMember.appId, $app.id), not($projectMember.revokedAt)), at($projectMember, "role"), null)
      let role = if(includes(list("owner", "admin"), $member.role), "steward", $explicit)
      when not($role):
        port kernel.invoke { query = "controlAccess.refuse"; input = { status = 403; code = "project-membership-required";
          message = "Active membership of this project is required." } } → denied
    port kernel.invoke { query = "hostedBearer.permissions"; input = { portfolio = $portfolio; role = $role;
      permissions = $scope.permissions } } → allowed
    when not($allowed):
      port kernel.invoke { query = "controlAccess.refuse"; input = { status = 403; code = "credential-permissions-invalid";
        message = if($portfolio, "An application-portfolio MCP credential accepts only authored authoring and project-lifecycle scope ceilings.",
          concat("Project role ", $role, " does not grant every requested credential permission.")) } } → denied
  let public = { id = $input.id; tenantId = $scope.tenantId; appId = $scope.appId; projectId = $scope.projectId;
    workspaceId = $scope.workspaceId; name = $scope.name; permissions = $scope.permissions; createdAt = $input.occurredAt;
    expiresAt = $scope.expiresAt; revokedAt = null }
  when $portfolio:
    port record.put { record = $public; key = "scopeMode"; value = "application-portfolio-v1" } → public
  let owned = $public
  when $scope.personal:
    port record.put { record = $public; key = "subjectUserId"; value = $principal.userId } → owned
  port record.put { record = $owned; key = "tokenDigest"; value = $input.tokenDigest } → credential
  let metadata = { appId = $scope.appId; projectId = $scope.projectId; workspaceId = $scope.workspaceId;
    permissions = $scope.permissions; expiresAt = $scope.expiresAt }
  when $scope.personal:
    port record.put { record = $metadata; key = "scopeMode";
      value = if($portfolio, "application-portfolio-v1", "project") } → metadata
  let audit = { id = $input.auditId; occurredAt = $input.occurredAt; actorKind = $principal.kind;
    actorId = or($principal.userId, $principal.credentialId, "system"); tenantId = $scope.tenantId;
    action = if($scope.personal, "developerCredential.personal.created", "developerCredential.created");
    resourceType = "developerCredential"; resourceId = $input.id; metadata = $metadata }
  let result = { credential = $credential; audit = $audit; public = $public }

process credentialIssuance.snapshot:
  let state = $eventInput
  port kernel.invoke { query = "controlAccess.databaseSnapshot"; input = $state } → revision
  port number.calculate { operation = "less"; values = list($state.rowRevision, 9007199254740991) } → advance
  assert $advance
    otherwise "Hosted credential issuance cannot advance the authority revision."
  each $state.counts as size:
    port number.calculate { operation = "lessEqual"; values = list($size, 1) } → unique
    assert $unique
      otherwise "Hosted credential issuance authority is ambiguous."
  let result = $state.rowRevision
